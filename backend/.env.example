# ── MongoDB ───────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pooja-vegetables

# ── JWT ───────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── App config ────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Business rules ────────────────────────────
SHOP_LAT=18.5204          # Your shop latitude (Pune default)
SHOP_LNG=73.8567          # Your shop longitude
MAX_DELIVERY_KM=4
MIN_ORDER_AMOUNT=150

# ── CORS — comma separated allowed origins ────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
